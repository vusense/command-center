# Optional: copy to credentials.yaml for multi-user auth (streamlit-authenticator)
# Generate password hashes with: python -c "import streamlit_authenticator as a; print(a.Hasher.hash(['yourpassword']))"

credentials:
  usernames:
    cofounder_a:
      email: a@example.com
      name: Cofounder A
      password: $2b$12$REPLACE_WITH_HASH
    cofounder_b:
      email: b@example.com
      name: Cofounder B
      password: $2b$12$REPLACE_WITH_HASH
cookie:
  expiry_days: 30
  key: random_signature_key_change_me
  name: vusense_decision_cookie
